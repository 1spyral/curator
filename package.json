{
  "name": "curator",
  "private": true,
  "workspaces": [
    "core",
    "mcp",
    "cli",
    "web"
  ],
  "scripts": {
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "db:generate": "bun run --cwd core db:generate",
    "db:migrate": "bun run --cwd core db:migrate",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "web": "bun run --cwd web dev",
    "mcp": "bun mcp/src/index.ts",
    "cli": "bun cli/src/index.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "latest",
    "typescript": "^7"
  }
}
